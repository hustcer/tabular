///|
// Upstream: tabled/tests/settings/render_settings.rs::alignment_per_line
test "upstream render_settings alignment_per_line" {
  let actual = upstream_multiline_data1()
    .apply(@tabular.Style::psql())
    .with_(
      @tabular.Modify::new(@tabular.Segment::all())
      .with_(@tabular.Alignment::right())
      .with_(@tabular.AlignmentStrategy::PerLine),
    )
    .to_string()
  assert_eq(
    actual,
    [
      "         N | column 0 | column 1 | column 2 ", "-----------+----------+----------+----------",
      "         0 |      0-0 |      0-1 |      0-2 ", "       asd |      1-0 |      1-1 |      1-2 ",
      "  21213123 |          |          |          ", "           |          |          |          ",
      "    asdasd |          |          |          ", "           |          |          |          ",
      "           |          |          |          ", "         2 |      2-0 | https:// |      2-2 ",
      "           |          |      www |          ", "           |          |        . |          ",
      "           |          |   redhat |          ", "           |          |     .com |          ",
      "           |          |      /en |          ",
    ].join("\n"),
  )
}

