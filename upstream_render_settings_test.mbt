test "upstream render_settings test_top_alignment_and_vertical_trim_1" {
  let actual = upstream_string_table(["   \n\n\n    Hello World"])
    .set_align(@tabular.Align::center())
    .apply(@tabular.Style::modern())
    .with_(
      @tabular.Modify::new(@tabular.Segment::all())
      .with_(@tabular.Alignment::top())
      .with_(@tabular.TrimStrategy::Vertical),
    )
    .to_string()
  assert_eq(
    actual,
    (
      #|┌─────────────────┐
      #|│      &str       │
      #|├─────────────────┤
      #|│     Hello World │
      #|│                 │
      #|│                 │
      #|│                 │
      #|└─────────────────┘
    ),
  )
}

