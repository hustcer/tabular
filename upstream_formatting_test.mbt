///|
// Upstream: tabled/tests/settings/formatting_test.rs::justification_columns
test "upstream formatting justification_columns" {
  let actual = upstream_matrix(3, 3)
    .with_(
      @tabular.Modify::new(@tabular.Cols::one(1)).with_(
        @tabular.Justification::new('#'),
      ),
    )
    .with_(
      @tabular.Modify::new(@tabular.Cols::one(2)).with_(
        @tabular.Justification::new('@'),
      ),
    )
    .with_(
      @tabular.Modify::new(@tabular.Cols::one(3)).with_(
        @tabular.Justification::new('$'),
      ),
    )
    .to_string()
  assert_eq(
    actual,
    (
      #|+---+----------+----------+----------+
      #|| N | column 0 | column 1 | column 2 |
      #|+---+----------+----------+----------+
      #|| 0 | ##0-0### | @@0-1@@@ | $$0-2$$$ |
      #|+---+----------+----------+----------+
      #|| 1 | ##1-0### | @@1-1@@@ | $$1-2$$$ |
      #|+---+----------+----------+----------+
      #|| 2 | ##2-0### | @@2-1@@@ | $$2-2$$$ |
      #|+---+----------+----------+----------+
    ),
  )
}

