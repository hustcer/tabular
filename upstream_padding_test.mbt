///|
// Upstream: tabled/tests/settings/padding_test.rs::padding
test "upstream padding padding" {
  let actual = upstream_matrix(3, 3)
    .apply(@tabular.Style::psql())
    .with_(
      @tabular.Modify::new(@tabular.Segment::all()).with_(
        @tabular.Alignment::left(),
      ),
    )
    .with_(
      @tabular.Modify::new(@tabular.Rows::new(1, -1)).with_(
        @tabular.Padding::new(1, 1, 0, 2),
      ),
    )
    .to_string()
  assert_eq(
    actual,
    [
      " N | column 0 | column 1 | column 2 ", "---+----------+----------+----------",
      " 0 | 0-0      | 0-1      | 0-2      ", "   |          |          |          ",
      "   |          |          |          ", " 1 | 1-0      | 1-1      | 1-2      ",
      "   |          |          |          ", "   |          |          |          ",
      " 2 | 2-0      | 2-1      | 2-2      ", "   |          |          |          ",
      "   |          |          |          ",
    ].join("\n"),
  )
}

///|
// Upstream: tabled/tests/settings/padding_test.rs::padding_with_set_characters
test "upstream padding padding_with_set_characters" {
  let actual = upstream_matrix(3, 3)
    .apply(@tabular.Style::psql())
    .with_(
      @tabular.Modify::new(@tabular.Segment::all()).with_(
        @tabular.Padding::new(1, 2, 1, 1).fill(
          left='>',
          right='<',
          top='V',
          bottom='^',
        ),
      ),
    )
    .to_string()
  assert_eq(
    actual,
    (
      #|VVVV|VVVVVVVVVVV|VVVVVVVVVVV|VVVVVVVVVVV
      #|>N<<|>column 0<<|>column 1<<|>column 2<<
      #|^^^^|^^^^^^^^^^^|^^^^^^^^^^^|^^^^^^^^^^^
      #|----+-----------+-----------+-----------
      #|VVVV|VVVVVVVVVVV|VVVVVVVVVVV|VVVVVVVVVVV
      #|>0<<|>  0-0   <<|>  0-1   <<|>  0-2   <<
      #|^^^^|^^^^^^^^^^^|^^^^^^^^^^^|^^^^^^^^^^^
      #|VVVV|VVVVVVVVVVV|VVVVVVVVVVV|VVVVVVVVVVV
      #|>1<<|>  1-0   <<|>  1-1   <<|>  1-2   <<
      #|^^^^|^^^^^^^^^^^|^^^^^^^^^^^|^^^^^^^^^^^
      #|VVVV|VVVVVVVVVVV|VVVVVVVVVVV|VVVVVVVVVVV
      #|>2<<|>  2-0   <<|>  2-1   <<|>  2-2   <<
      #|^^^^|^^^^^^^^^^^|^^^^^^^^^^^|^^^^^^^^^^^
    ),
  )
}

