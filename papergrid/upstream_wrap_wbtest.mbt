///|
// Upstream: tabled/src/settings/width/wrap.rs::chunks_test_with_prefix_and_suffix
test "upstream wrap unit chunks_test_with_prefix_and_suffix" {
  assert_eq(wrap_basic("123456", 0, "^", "$"), Array::make(0, "^$").join("\n"))

  assert_eq(
    wrap_basic("123456", 1, "^", "$"),
    ["^1$", "^2$", "^3$", "^4$", "^5$", "^6$"].join("\n"),
  )
  assert_eq(
    wrap_basic("123456", 2, "^", "$"),
    ["^12$", "^34$", "^56$"].join("\n"),
  )
  assert_eq(
    wrap_basic("12345", 2, "^", "$"),
    ["^12$", "^34$", "^5$"].join("\n"),
  )

  assert_eq(
    wrap_basic("😳😳😳😳😳", 1, "^", "$"),
    ["^�$", "^�$", "^�$", "^�$", "^�$"].join("\n"),
  )
  assert_eq(
    wrap_basic("😳😳😳😳😳", 2, "^", "$"),
    ["^😳$", "^😳$", "^😳$", "^😳$", "^😳$"].join("\n"),
  )
  assert_eq(
    wrap_basic("😳😳😳😳😳", 3, "^", "$"),
    "^😳$\n^😳$\n^😳$\n^😳$\n^😳$",
  )
}

///|
// Upstream: tabled/src/settings/width/wrap.rs::split_by_line_keeping_words_test_with_prefix_and_suffix
test "upstream wrap unit split_by_line_keeping_words_test_with_prefix_and_suffix" {
  assert_eq(wrap_words("123456", 1, "^", "$"), "^1$\n^2$\n^3$\n^4$\n^5$\n^6$")
  assert_eq(wrap_words("123456", 2, "^", "$"), "^12$\n^34$\n^56$")
  assert_eq(wrap_words("12345", 2, "^", "$"), "^12$\n^34$\n^5$")

  assert_eq(
    wrap_words("😳😳😳😳😳", 1, "^", "$"),
    "^�$\n^�$\n^�$\n^�$\n^�$",
  )
}

