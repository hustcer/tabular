// Upstream: tabled/src/settings/width/wrap.rs::split_by_line_keeping_words_color_3_test
test "upstream wrap unit split_by_line_keeping_words_color_3_test" {
  assert_eq(
    upstream_wrap_words(
      "\u001b[37m🚵🏻🚵🏻🚵🏻🚵🏻🚵🏻🚵🏻🚵🏻🚵🏻🚵🏻🚵🏻\u001b[0m",
      3,
    ),
    "\u001b[37m🚵\u001b[39m\n\u001b[37m🏻\u001b[39m\n\u001b[37m🚵\u001b[39m\n\u001b[37m🏻\u001b[39m\n\u001b[37m🚵\u001b[39m\n\u001b[37m🏻\u001b[39m\n\u001b[37m🚵\u001b[39m\n\u001b[37m🏻\u001b[39m\n\u001b[37m🚵\u001b[39m\n\u001b[37m🏻\u001b[39m\n\u001b[37m🚵\u001b[39m\n\u001b[37m🏻\u001b[39m\n\u001b[37m🚵\u001b[39m\n\u001b[37m🏻\u001b[39m\n\u001b[37m🚵\u001b[39m\n\u001b[37m🏻\u001b[39m\n\u001b[37m🚵\u001b[39m\n\u001b[37m🏻\u001b[39m\n\u001b[37m🚵\u001b[39m\n\u001b[37m🏻\u001b[39m",
  )
  assert_eq(
    upstream_wrap_words("\u001b[37mthis is a long sentence\u001b[0m", 7),
    "\u001b[37mthis is\u001b[39m\n\u001b[37m a long\u001b[39m\n\u001b[37m senten\u001b[39m\n\u001b[37mce\u001b[39m",
  )
  assert_eq(
    upstream_wrap_words("\u001b[37mHello World\u001b[0m", 7),
    "\u001b[37mHello \u001b[39m\n\u001b[37mWorld\u001b[39m",
  )
  assert_eq(
    upstream_wrap_words("\u001b[37mHello Wo\u001b[37mrld\u001b[0m", 7),
    "\u001b[37mHello \u001b[39m\n\u001b[37mWo\u001b[39m\u001b[37mrld\u001b[39m",
  )
  assert_eq(
    upstream_wrap_words("\u001b[37mHello Wo\u001b[37mrld\u001b[0m", 8),
    "\u001b[37mHello \u001b[39m\n\u001b[37mWo\u001b[39m\u001b[37mrld\u001b[39m",
  )
}

