///|
// Upstream: tabled/src/settings/width/wrap.rs::split_by_line_keeping_words_test
test "upstream wrap unit split_by_line_keeping_words_test" {
  assert_eq(upstream_wrap_words("123456", 1), "1\n2\n3\n4\n5\n6")
  assert_eq(upstream_wrap_words("123456", 2), "12\n34\n56")
  assert_eq(upstream_wrap_words("12345", 2), "12\n34\n5")

  assert_eq(
    upstream_wrap_words("😳😳😳😳😳", 1),
    "�\n�\n�\n�\n�",
  )

  assert_eq(upstream_wrap_words("111 234 1", 4), "111 \n234 \n1")
}

