// Upstream: tabled/src/settings/width/wrap.rs::chunks_wrap_2
test "upstream wrap unit chunks_wrap_2" {
  let text = "\u001b[30mDebian\u001b[0m\u001b[31mDebian\u001b[0m\u001b[32mDebian\u001b[0m\u001b[33mDebian\u001b[0m\u001b[34mDebian\u001b[0m\u001b[35mDebian\u001b[0m\u001b[36mDebian\u001b[0m\u001b[37mDebian\u001b[0m\u001b[40mDebian\u001b[0m\u001b[41mDebian\u001b[0m\u001b[42mDebian\u001b[0m\u001b[43mDebian\u001b[0m\u001b[44mDebian\u001b[0m"
  assert_eq(
    wrap_basic(text, 30, "", ""),
    [
      "\u001b[30mDebian\u001b[39m\u001b[31mDebian\u001b[39m\u001b[32mDebian\u001b[39m\u001b[33mDebian\u001b[39m\u001b[34mDebian\u001b[39m",
      "\u001b[35mDebian\u001b[39m\u001b[36mDebian\u001b[39m\u001b[37mDebian\u001b[39m\u001b[40mDebian\u001b[49m\u001b[41mDebian\u001b[49m",
      "\u001b[42mDebian\u001b[49m\u001b[43mDebian\u001b[49m\u001b[44mDebian\u001b[49m",
    ].join("\n"),
  )
}

