  assert_eq(
    wrap_words(text, 22, "", ""),
    "\u001b[37mCreate bytes from the \u001b[39m\n\u001b[7m\u001b[34marg\u001b[27m\u001b[39m\u001b[37muments.\u001b[39m",
  )
}

///|
// Upstream: tabled/src/settings/width/wrap.rs::chunks_wrap_4
test "upstream wrap unit chunks_wrap_4" {
  let text = "\u001b[37mReturns the floor of a number (l\u001b[0m\u001b[41;37marg\u001b[0m\u001b[37mest integer less than or equal to that number).\u001b[0m"

  assert_eq(
    wrap_basic(text, 10, "", ""),
    [
      "\u001b[37mReturns th\u001b[39m", "\u001b[37me floor of\u001b[39m", "\u001b[37m a number \u001b[39m",
      "\u001b[37m(l\u001b[39m\u001b[37m\u001b[41marg\u001b[39m\u001b[49m\u001b[37mest i\u001b[39m",
      "\u001b[37mnteger les\u001b[39m", "\u001b[37ms than or \u001b[39m", "\u001b[37mequal to t\u001b[39m",
      "\u001b[37mhat number\u001b[39m", "\u001b[37m).\u001b[39m",
    ].join("\n"),
  )
}

///|
// Upstream: tabled/src/settings/width/wrap.rs::chunks_wrap_4_keeping_words
test "upstream wrap unit chunks_wrap_4_keeping_words" {
  let text = "\u001b[37mReturns the floor of a number (l\u001b[0m\u001b[41;37marg\u001b[0m\u001b[37mest integer less than or equal to that number).\u001b[0m"
  assert_eq(
    wrap_words(text, 10, "", ""),
    [
      "\u001b[37mReturns \u001b[39m\n", "\u001b[37mthe floor \u001b[39m\n", "\u001b[37mof a \u001b[39m\n",
      "\u001b[37mnumber \u001b[39m\n", "\u001b[37m(l\u001b[39m\u001b[37m\u001b[41marg\u001b[39m\u001b[49m\u001b[37mest \u001b[39m\n",
      "\u001b[37minteger \u001b[39m\n", "\u001b[37mless than \u001b[39m\n", "\u001b[37mor equal \u001b[39m\n",
      "\u001b[37mto that \u001b[39m\n", "\u001b[37mnumber).\u001b[39m",
    ].join(""),
  )
}

///|
// Upstream: tabled/src/settings/width/wrap.rs::chunks_wrap_5_keeping_words
test "upstream wrap unit chunks_wrap_5_keeping_words" {
  let text = "修复 zlib 软件包中 CMake 配置不一致的问题，该问题先前导致部分软件无法正常构建"
  assert_eq(
    upstream_wrap_words(text, 44),
    "修复 zlib 软件包中 CMake 配置不一致的问题，\n该问题先前导致部分软件无法正常构建",
  )
}

///|
// Upstream: tabled/src/settings/width/wrap.rs::chunks_chinese_0
test "upstream wrap unit chunks_chinese_0" {
  let text = "(公司{ 名称:\"腾讯科技（深圳）有限公司\",成立时间:\"1998年11月\"}"
  assert_eq(
    upstream_wrap_words(text, 40),
    [
      "(公司{ 名称:\"腾讯科技（深圳）有限公司\",\n", "成立时间:\"1998年11月\"}",
    ].join(""),
  )
}

