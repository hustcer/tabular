///|
// Upstream: tabled/src/util/string.rs::strip_test
test "upstream string strip_test" {
  assert_eq(cut_str("123456", 0), "")
  assert_eq(cut_str("123456", 3), "123")
  assert_eq(cut_str("123456", 10), "123456")

  assert_eq(cut_str("a week ago", 4), "a we")

  assert_eq(cut_str("123\n456789", 0), "")
  assert_eq(cut_str("123\n456789", 2), "12")
  assert_eq(cut_str("123\n456789", 3), "123")
  assert_eq(cut_str("123\n456789", 4), "123\n4567")
  assert_eq(cut_str("123\n45\n67\n89", 4), "123\n45\n67\n89")
  assert_eq(cut_str("123\n45\n67\n89\n", 4), "123\n45\n67\n89\n")

  assert_eq(cut_str("😳😳😳😳😳", 0), "")
  assert_eq(cut_str("😳😳😳😳😳", 3), "😳�")
  assert_eq(cut_str("😳😳😳😳😳", 4), "😳😳")
  assert_eq(cut_str("😳😳😳😳😳", 20), "😳😳😳😳😳")

  assert_eq(cut_str("🏳️🏳️", 0), "")
  assert_eq(cut_str("🏳️🏳️", 1), "🏳")
  assert_eq(cut_str("🏳️🏳️", 2), "🏳️")
  assert_eq(get_line_width("🏳️🏳️"), get_line_width("🏳️🏳️"))

  assert_eq(cut_str("🎓", 1), "�")
  assert_eq(cut_str("🎓", 2), "🎓")

  assert_eq(cut_str("🥿", 1), "�")
  assert_eq(cut_str("🥿", 2), "🥿")

  assert_eq(cut_str("🩰", 1), "�")
  assert_eq(cut_str("🩰", 2), "🩰")

  assert_eq(cut_str("👍🏿", 1), "�")
  assert_eq(cut_str("👍🏿", 2), "👍")
  assert_eq(cut_str("👍🏿", 3), "👍�")
  assert_eq(cut_str("👍🏿", 4), "👍🏿")

  assert_eq(cut_str("🇻🇬", 1), "🇻")
  assert_eq(cut_str("🇻🇬", 2), "🇻🇬")
  assert_eq(cut_str("🇻🇬", 3), "🇻🇬")
  assert_eq(cut_str("🇻🇬", 4), "🇻🇬")
}

///|
// Upstream: tabled/src/util/string.rs::strip_color_test
test "upstream string strip_color_test" {
  let numbers = "\u001b[31;100m123456\u001b[39m\u001b[49m"

  assert_eq(cut_str(numbers, 0), "\u001b[31;100m\u001b[39m\u001b[49m")
  assert_eq(cut_str(numbers, 3), "\u001b[31;100m123\u001b[39m\u001b[49m")
  assert_eq(cut_str(numbers, 10), "\u001b[31;100m123456\u001b[39m\u001b[49m")

  let emojies = "\u001b[31;100m😳😳😳😳😳\u001b[39m\u001b[49m"

  assert_eq(cut_str(emojies, 0), "\u001b[31;100m\u001b[39m\u001b[49m")
  assert_eq(cut_str(emojies, 3), "\u001b[31;100m😳\u001b[39m\u001b[49m�")
  assert_eq(cut_str(emojies, 4), "\u001b[31;100m😳😳\u001b[39m\u001b[49m")
  assert_eq(
    cut_str(emojies, 20),
    "\u001b[31;100m😳😳😳😳😳\u001b[39m\u001b[49m",
  )

  let emojies = "\u001b[31;100m🏳️🏳️\u001b[39m\u001b[49m"

  assert_eq(cut_str(emojies, 0), "\u001b[31;100m\u001b[39m\u001b[49m")
  assert_eq(cut_str(emojies, 1), "\u001b[31;100m🏳\u001b[39m\u001b[49m")
  assert_eq(cut_str(emojies, 2), "\u001b[31;100m🏳️\u001b[39m\u001b[49m")
  assert_eq(
    get_line_width(emojies),
    get_line_width("\u001b[31;100m🏳️🏳️\u001b[39m\u001b[49m"),
  )
}

///|
// Upstream: tabled/src/util/string.rs::test_color_strip
test "upstream string test_color_strip" {
  let s = "\u001b[5;33;48;2;12;200;100mCollored string\u001b[0m"
  assert_eq(
    cut_str(s, 1),
    "\u001b[5;33;48;2;12;200;100mC\u001b[25m\u001b[39m\u001b[49m",
  )
}

///|
// Upstream: tabled/src/settings/width/wrap.rs::split_test
test "upstream string split_test" {
  assert_eq(wrap_text("123456", 0), "")

  assert_eq(wrap_text("123456", 1), "1\n2\n3\n4\n5\n6")
  assert_eq(wrap_text("123456", 2), "12\n34\n56")
  assert_eq(wrap_text("12345", 2), "12\n34\n5")
  assert_eq(wrap_text("123456", 6), "123456")
  assert_eq(wrap_text("123456", 10), "123456")

  assert_eq(wrap_text("😳😳😳😳😳", 1), "�\n�\n�\n�\n�")
  assert_eq(
    wrap_text("😳😳😳😳😳", 2),
    "😳\n😳\n😳\n😳\n😳",
  )
  assert_eq(
    wrap_text("😳😳😳😳😳", 3),
    "😳\n😳\n😳\n😳\n😳",
  )
  assert_eq(wrap_text("😳😳😳😳😳", 6), "😳😳😳\n😳😳")
  assert_eq(wrap_text("😳😳😳😳😳", 20), "😳😳😳😳😳")

  assert_eq(wrap_text("😳123😳", 1), "�\n1\n2\n3\n�")
  assert_eq(wrap_text("😳12😳3", 1), "�\n1\n2\n�\n3")
}

///|
// Upstream: tabled/src/settings/width/wrap.rs::chunks_test
test "upstream string chunks_test" {
  assert_eq(wrap_text("123456", 0), "")

  assert_eq(wrap_text("123456", 1), ["1", "2", "3", "4", "5", "6"].join("\n"))
  assert_eq(wrap_text("123456", 2), ["12", "34", "56"].join("\n"))
  assert_eq(wrap_text("12345", 2), ["12", "34", "5"].join("\n"))

  assert_eq(
    wrap_text("😳😳😳😳😳", 1),
    ["�", "�", "�", "�", "�"].join("\n"),
  )
  assert_eq(
    wrap_text("😳😳😳😳😳", 2),
    ["😳", "😳", "😳", "😳", "😳"].join("\n"),
  )
  assert_eq(
    wrap_text("😳😳😳😳😳", 3),
    ["😳", "😳", "😳", "😳", "😳"].join("\n"),
  )
}
