    Formatting::new(trim_horizontal=true, trim_vertical=true, align_lines=true),
  )
  assert_eq(
    upstream_formatting_render(
      [
        ["A long string", "\n\n\nA\n    string\nwith\n new\nline\n\n\n"],
        ["1-0", "1-1"],
        ["A one more\n    string\nwith\n new\nline", "..."],
      ],
      cfg,
    ),
    (
      #|+-------------+----------+
      #||             |          |
      #||             |          |
      #||             |          |
      #||             |         A|
      #||             |    string|
      #||A long string|      with|
      #||             |       new|
      #||             |      line|
      #||             |          |
      #||             |          |
      #||             |          |
      #|+-------------+----------+
      #||          1-0|       1-1|
      #|+-------------+----------+
      #||   A one more|          |
      #||       string|          |
      #||         with|       ...|
      #||          new|          |
      #||         line|          |
      #|+-------------+----------+
    ),
  )
}

