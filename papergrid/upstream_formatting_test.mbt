///|
// Upstream: papergrid/tests/grid/format_configuration.rs::formatting_1x1_test
test "upstream grid formatting 1x1 0" {
  let cfg = upstream_formatting_config()
  cfg.set_formatting(
    Entity::Global,
    Formatting::new(
      trim_horizontal=false,
      trim_vertical=false,
      align_lines=false,
    ),
  )
  assert_eq(
    upstream_formatting_render(
      [
        [
          "\n{\n    \"id\": \"0001\",\n    \"batters\": {\n        \"batter\": [\n            { \"id\": \"1002\", \"type\": \"Chocolate\" },\n        ]\n    },\n    \"topping\": [\n        { \"id\": \"5003\", \"type\": \"Chocolate\" },\n        { \"id\": \"5004\", \"type\": \"Maple\" }\n    ]\n}",
        ],
      ],
      cfg,
    ),
    (
      #|+--------------------------------------------------+
      #||                                                  |
      #||{                                                 |
      #||    "id": "0001",                                 |
      #||    "batters": {                                  |
      #||        "batter": [                               |
      #||            { "id": "1002", "type": "Chocolate" },|
      #||        ]                                         |
      #||    },                                            |
      #||    "topping": [                                  |
      #||        { "id": "5003", "type": "Chocolate" },    |
      #||        { "id": "5004", "type": "Maple" }         |
      #||    ]                                             |
      #||}                                                 |
      #|+--------------------------------------------------+
    ),
  )
}

