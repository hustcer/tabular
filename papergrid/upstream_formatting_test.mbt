///|
// Upstream: papergrid/tests/grid/format_configuration.rs::formatting_test
test "upstream grid formatting variant 0" {
  let cfg = upstream_formatting_config()
  cfg.set_align(HAlign::left())
  cfg.set_valign(VAlign::top())
  cfg.set_formatting(
    Entity::Global,
    Formatting::new(
      trim_horizontal=false,
      trim_vertical=false,
      align_lines=true,
    ),
  )
  assert_eq(
    upstream_formatting_render(
      [
        ["A long string", "\n\n\nA\n    string\nwith\n new\nline\n\n\n"],
        ["1-0", "1-1"],
        ["A one more\n    string\nwith\n new\nline", "..."],
      ],
      cfg,
    ),
    (
      #|+-------------+----------+
      #||A long string|          |
      #||             |          |
      #||             |          |
      #||             |A         |
      #||             |    string|
      #||             |with      |
      #||             | new      |
      #||             |line      |
      #||             |          |
      #||             |          |
      #||             |          |
      #|+-------------+----------+
      #||1-0          |1-1       |
      #|+-------------+----------+
      #||A one more   |...       |
      #||    string   |          |
      #||with         |          |
      #|| new         |          |
      #||line         |          |
      #|+-------------+----------+
    ),
  )
}

