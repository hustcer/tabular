// Generated by scripts/import-unicode-width.nu.

///|
// Exhaustive independent Rust reference: every valid Unicode scalar.
test "Unicode scalar width digests" {
  let mut chars : UInt64 = 14695981039346656037UL
  let mut strings = chars
  for cp in 0..<=0x10ffff {
    if cp.to_char() is Some(ch) {
      chars = (chars ^ get_char_width(ch).to_uint64()) * 1099511628211UL
      strings = (strings ^ get_string_width(ch.to_string()).to_uint64()) *
        1099511628211UL
    }
  }
  assert_eq(chars, 2143679130850314550UL)
  assert_eq(strings, 1241503923772603629UL)
}
