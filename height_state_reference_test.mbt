///|
// Reference: tabled height options, original records and observable cache state.
test "height state reference list" {
  let table = @tabular.Table::from_rows([
    ["a\nb\nc\n", "long value"],
    ["d\ne", "x\ny\nz"],
    ["", "q"],
  ])
  table.with_(@tabular.Height::list([2, 0, 3])) |> ignore
  assert_eq(
    table.to_string(),
    "+---+------------+\n| a | long value |\n| b |            |\n+---+------------+\n+---+------------+\n|   | q          |\n|   |            |\n|   |            |\n+---+------------+",
  )
  assert_eq(table.dimension_snapshot().get_widths(), None)
  assert_eq(table.dimension_snapshot().get_heights(), Some([2, 0, 3]))
  assert_eq(table.total_width(), 18)
  assert_eq(table.total_height(), 9)
  assert_eq(table.rows, [
    ["a\nb\nc\n", "long value"],
    ["d\ne", "x\ny\nz"],
    ["", "q"],
  ])
}

