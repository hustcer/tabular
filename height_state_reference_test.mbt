///|
// Reference: tabled height options, original records and observable cache state.
test "height state reference width-cache" {
  let table = @tabular.Table::from_rows([
    ["a\nb\nc\n", "long value"],
    ["d\ne", "x\ny\nz"],
    ["", "q"],
  ])
  table.with_(@tabular.Width::list([8, 12])).with_(@tabular.Height::limit(7))
  |> ignore
  assert_eq(
    table.to_string(),
    "+--------+------------+\n| a      | long value |\n| b      |            |\n+--------+------------+\n| d      | x          |\n+--------+------------+\n+--------+------------+",
  )
  assert_eq(table.dimension_snapshot().get_widths(), Some([8, 12]))
  assert_eq(table.dimension_snapshot().get_heights(), Some([2, 1, 0]))
  assert_eq(table.total_width(), 23)
  assert_eq(table.total_height(), 7)
  assert_eq(table.rows, [["a\nb", "long value"], ["d", "x"], ["", ""]])
}

///|
// Reference: tabled height options, original records and observable cache state.
test "height state reference width-after-height" {
  let table = @tabular.Table::from_rows([
    ["a\nb\nc\n", "long value"],
    ["d\ne", "x\ny\nz"],
    ["", "q"],
  ])
  table.with_(@tabular.Height::increase(20)).with_(@tabular.Width::wrap(18))
  |> ignore
  assert_eq(
    table.to_string(),
    "+---+------------+\n| a | long value |\n| b |            |\n| c |            |\n|   |            |\n+---+------------+\n| d | x          |\n| e | y          |\n|   | z          |\n+---+------------+\n|   | q          |\n+---+------------+",
  )
  assert_eq(table.dimension_snapshot().get_widths(), Some([3, 12]))
  assert_eq(table.dimension_snapshot().get_heights(), None)
  assert_eq(table.total_width(), 18)
  assert_eq(table.total_height(), 12)
  assert_eq(table.rows, [
    ["a\nb\nc\n", "long value"],
    ["d\ne", "x\ny\nz"],
    ["", "q"],
  ])
}

///|
// Reference: tabled height options, original records and observable cache state.
test "height state reference nested" {
  let table = @tabular.Table::from_rows([
    ["a\nb\nc\n", "long value"],
    ["d\ne", "x\ny\nz"],
    ["", "q"],
  ])
  table.with_(
    (
      @tabular.Modify::new(@tabular.Rows::first()).with_(
        @tabular.Height::increase(8),
      ),
      @tabular.Height::limit(12),
    ),
  )
  |> ignore
  assert_eq(
    table.to_string(),
    "+---+------------+\n| a | long value |\n| b |            |\n| c |            |\n|   |            |\n|   |            |\n|   |            |\n+---+------------+\n| d | x          |\n| e | y          |\n+---+------------+\n|   |            |\n+---+------------+",
  )
  assert_eq(table.dimension_snapshot().get_widths(), None)
  assert_eq(table.dimension_snapshot().get_heights(), None)
  assert_eq(table.total_width(), 18)
  assert_eq(table.total_height(), 13)
  assert_eq(table.rows, [
    ["a\nb\nc\n\n\n", "long value\n\n\n\n\n"],
    ["d\ne", "x\ny"],
    ["", ""],
  ])
}

///|
// Reference: tabled height options, original records and observable cache state.
test "height state reference markdown" {
  let table = @tabular.Table::from_rows([
    ["a\nb\nc\n", "long value"],
    ["d\ne", "x\ny\nz"],
    ["", "q"],
  ])
  table.apply(@tabular.Style::markdown()).with_(@tabular.Height::limit(3))
  |> ignore
  assert_eq(
    table.to_string(),
    "| a | long value |\n|---|------------|\n| d | x          |",
  )
  assert_eq(table.dimension_snapshot().get_widths(), None)
  assert_eq(table.dimension_snapshot().get_heights(), Some([1, 1, 0]))
  assert_eq(table.total_width(), 18)
  assert_eq(table.total_height(), 3)
  assert_eq(table.rows, [["a", "long value"], ["d", "x"], ["", ""]])
}

