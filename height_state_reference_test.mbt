  assert_eq(table.total_height(), 10)
  assert_eq(table.rows, [
    ["a\r\nb\r", "long value"],
    ["d\ne", "x\ny\nz"],
    ["", "q"],
  ])
}

///|
// Reference: tabled height options, original records and observable cache state.
test "height state reference ansi" {
  let table = @tabular.Table::from_rows([
    ["a\nb\nc\n", "long value"],
    ["d\ne", "x\ny\nz"],
    ["", "q"],
  ])
  table
  .modify((0, 0), "\u001b[31ma\nb\nc\u001b[39m")
  .modify((0, 0), @tabular.Height::limit(2))
  |> ignore
  assert_eq(
    table.to_string(),
    "+---+------------+\n| \u001b[31ma\u001b[39m | long value |\n| \u001b[31mb\u001b[39m |            |\n+---+------------+\n| d | x          |\n| e | y          |\n|   | z          |\n+---+------------+\n|   | q          |\n+---+------------+",
  )
