test "upstream rotate test_3x3_box_0" {
  let actual = upstream_int_table([[123, 456, 789], [234, 567, 891]])
    .rotate(@tabular.Rotate::Left)
    .to_string()
  assert_eq(
    actual,
    (
      #|+-----+-----+-----+
      #|| i32 | 789 | 891 |
      #|+-----+-----+-----+
      #|| i32 | 456 | 567 |
      #|+-----+-----+-----+
      #|| i32 | 123 | 234 |
      #|+-----+-----+-----+
    ),
  )
}

