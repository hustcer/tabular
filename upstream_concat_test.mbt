// Upstream: tabled/tests/settings/concat_test.rs::join_vertical_0
test "upstream concat join_vertical_0" {
  let actual = upstream_matrix(2, 3)
    .modify_cell(
      @tabular.Cell::new(1, 0),
      @tabular.Setting::format(@tabular.Format::value("123")),
    )
    .apply(@tabular.Style::psql())
    .concat(@tabular.Concat::vertical(upstream_matrix(2, 3)))
    .to_string()
  assert_eq(
    actual,
    (
      #|  N  | column 0 | column 1 | column 2 
      #|-----+----------+----------+----------
      #| 123 |   0-0    |   0-1    |   0-2    
      #|  1  |   1-0    |   1-1    |   1-2    
      #|  N  | column 0 | column 1 | column 2 
      #|  0  |   0-0    |   0-1    |   0-2    
      #|  1  |   1-0    |   1-1    |   1-2    
    ),
  )
}

