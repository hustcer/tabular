///|
// Upstream: tabled/tests/settings/duplicate_test.rs::dup_cell_to_cell
test "upstream duplicate dup_cell_to_cell" {
  let actual = upstream_matrix(3, 3)
    .duplicate(
      @tabular.Duplicate::new(
        source=@tabular.Cell::new(0, 1),
        destination=@tabular.Cell::new(0, 0),
      ),
    )
    .to_string()
  assert_eq(
    actual,
    (
      #|+----------+----------+----------+----------+
      #|| column 0 | column 0 | column 1 | column 2 |
      #|+----------+----------+----------+----------+
      #||    0     |   0-0    |   0-1    |   0-2    |
      #|+----------+----------+----------+----------+
      #||    1     |   1-0    |   1-1    |   1-2    |
      #|+----------+----------+----------+----------+
      #||    2     |   2-0    |   2-1    |   2-2    |
      #|+----------+----------+----------+----------+
    ),
  )
}

