  assert_eq(
    table, "\u001b[31m\u001b[44m\u001b[1mVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVV\u001b[39m\u001b[49m\u001b[22m\n\u001b[31m\u001b[44m\u001b[1mVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVV\u001b[39m\u001b[49m\u001b[22m\n\u001b[31m\u001b[1m>>\u001b[39m\u001b[22m N | column 0 | column 1 | column 2 \u001b[32m<<\u001b[39m\n\u001b[31m\u001b[1m>>\u001b[39m\u001b[22m---+----------+----------+----------\u001b[32m<<\u001b[39m\n\u001b[31m\u001b[1m>>\u001b[39m\u001b[22m 0 |   0-0    |   0-1    |   0-2    \u001b[32m<<\u001b[39m\n\u001b[31m\u001b[1m>>\u001b[39m\u001b[22m 1 |   1-0    |   1-1    |   1-2    \u001b[32m<<\u001b[39m\n\u001b[31m\u001b[1m>>\u001b[39m\u001b[22m 2 |   2-0    |   2-1    |   2-2    \u001b[32m<<\u001b[39m\n\u001b[34m\u001b[43m^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[39m\u001b[49m\n\u001b[34m\u001b[43m^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[39m\u001b[49m",
  )
}
