    .modify_cell(
      @tabular.Cell::new(3, 2),
      @tabular.Setting::format(
        @tabular.Format::value("https://\nwww\n.\nredhat\n.com\n/en"),
      ),
    )
    .apply(@tabular.Style::psql())
    .with_(
      @tabular.Modify::new(@tabular.Cell::new(3, 2)).with_(
        @tabular.Span::column(2),
      ),
