test "upstream margin margin_without_table_based_on_grid_borders" {
  let actual = upstream_matrix(3, 3)
    .modify_cell(
      @tabular.Cell::new(3, 2),
      @tabular.Setting::format(
        @tabular.Format::value("https://\nwww\n.\nredhat\n.com\n/en"),
      ),
    )
    .apply(@tabular.Style::psql())
    .with_(
      @tabular.Modify::new(@tabular.Cell::new(3, 2)).with_(
        @tabular.Span::column(2),
      ),
    )
    .with_(@tabular.Margin::new(1, 1, 1, 1).fill('>', '<', 'V', '^'))
    .to_string()
  assert_eq(
    actual,
    (
      #|VVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVV
      #|> N | column 0 | column 1 | column 2 <
      #|>---+----------+----------+----------<
      #|> 0 |   0-0    |   0-1    |   0-2    <
      #|> 1 |   1-0    |   1-1    |   1-2    <
      #|> 2 |   2-0    |      https://       <
      #|>   |          |      www            <
      #|>   |          |      .              <
      #|>   |          |      redhat         <
      #|>   |          |      .com           <
      #|>   |          |      /en            <
      #|^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
    ),
  )
}

