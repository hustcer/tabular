///|
// Upstream: tabled/tests/settings/margin_test.rs::margin_with_table_based_on_grid_borders
test "upstream margin margin_with_table_based_on_grid_borders" {
  let actual = upstream_matrix(3, 3)
    .apply(@tabular.Style::extended())
    .with_(@tabular.Highlight::outline_cell(@tabular.Cell::new(0, 0), '+'))
    .with_(@tabular.Highlight::outline_cell(@tabular.Cell::new(1, 1), '*'))
    .with_(@tabular.Margin::new(1, 2, 1, 2).fill('>', '<', 'V', '^'))
    .to_string()
  assert_eq(
    actual,
    (
      #|VVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVV
      #|>+++++══════════╦══════════╦══════════╗<<
      #|>+ N + column 0 ║ column 1 ║ column 2 ║<<
      #|>++++************══════════╬══════════╣<<
      #|>║ 0 *   0-0    *   0-1    ║   0-2    ║<<
      #|>╠═══************══════════╬══════════╣<<
      #|>║ 1 ║   1-0    ║   1-1    ║   1-2    ║<<
      #|>╠═══╬══════════╬══════════╬══════════╣<<
      #|>║ 2 ║   2-0    ║   2-1    ║   2-2    ║<<
      #|>╚═══╩══════════╩══════════╩══════════╝<<
      #|^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
      #|^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
    ),
  )
}

