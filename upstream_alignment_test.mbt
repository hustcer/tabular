///|
// Upstream: tabled/tests/settings/alignment_test.rs::full_alignment
test "upstream alignment full_alignment" {
  let actual = upstream_matrix(3, 3)
    .apply(@tabular.Style::psql())
    .with_(
      @tabular.Modify::new(@tabular.Segment::all()).with_(
        @tabular.Alignment::left(),
      ),
    )
    .to_string()
  assert_eq(
    actual,
    [
      " N | column 0 | column 1 | column 2 ", "---+----------+----------+----------",
      " 0 | 0-0      | 0-1      | 0-2      ", " 1 | 1-0      | 1-1      | 1-2      ",
      " 2 | 2-0      | 2-1      | 2-2      ",
    ].join("\n"),
  )
}

///|
// Upstream: tabled/tests/settings/alignment_test.rs::head_and_data_alignment
test "upstream alignment head_and_data_alignment" {
  let actual = upstream_matrix(3, 3)
    .with_(
      @tabular.Modify::new(@tabular.Rows::first()).with_(
        @tabular.Alignment::left(),
      ),
    )
    .with_(
      @tabular.Modify::new(@tabular.Rows::new(1, -1)).with_(
        @tabular.Alignment::right(),
      ),
    )
    .to_string()
  assert_eq(
    actual,
    (
      #|+---+----------+----------+----------+
      #|| N | column 0 | column 1 | column 2 |
      #|+---+----------+----------+----------+
      #|| 0 |      0-0 |      0-1 |      0-2 |
      #|+---+----------+----------+----------+
      #|| 1 |      1-0 |      1-1 |      1-2 |
      #|+---+----------+----------+----------+
      #|| 2 |      2-0 |      2-1 |      2-2 |
      #|+---+----------+----------+----------+
    ),
  )
}

///|
// Upstream: tabled/tests/settings/alignment_test.rs::full_alignment_multiline
test "upstream alignment full_alignment_multiline" {
  let actual = upstream_matrix(3, 3)
    .modify_cell(
      @tabular.Cell::new(3, 2),
      @tabular.Setting::format(
        @tabular.Format::value("https://\nwww\n.\nredhat\n.com\n/en"),
      ),
    )
    .apply(@tabular.Style::psql())
    .with_(
      @tabular.Modify::new(@tabular.Segment::all()).with_(
        @tabular.Alignment::left(),
      ),
    )
    .to_string()
  assert_eq(
    actual,
    [
      " N | column 0 | column 1 | column 2 ", "---+----------+----------+----------",
      " 0 | 0-0      | 0-1      | 0-2      ", " 1 | 1-0      | 1-1      | 1-2      ",
      " 2 | 2-0      | https:// | 2-2      ", "   |          | www      |          ",
      "   |          | .        |          ", "   |          | redhat   |          ",
      "   |          | .com     |          ", "   |          | /en      |          ",
    ].join("\n"),
  )
}

///|
// Upstream: tabled/tests/settings/alignment_test.rs::vertical_alignment_test
test "upstream alignment vertical_alignment_test" {
  let actual = upstream_matrix(3, 3)
    .modify_cell(
      @tabular.Cell::new(2, 2),
      @tabular.Setting::format(@tabular.Format::value("E\nnde\navou\nros")),
    )
    .modify_cell(
      @tabular.Cell::new(3, 2),
      @tabular.Setting::format(@tabular.Format::value("Red\nHat")),
    )
    .modify_cell(
      @tabular.Cell::new(3, 3),
      @tabular.Setting::format(
        @tabular.Format::value("https://\nwww\n.\nredhat\n.com\n/en"),
      ),
    )
    .apply(@tabular.Style::psql())
    .with_(
      @tabular.Modify::new(@tabular.Cols::new(1, -1)).with_(
        @tabular.Alignment::bottom(),
      ),
    )
    .to_string()
  assert_eq(
    actual,
    [
      " N | column 0 | column 1 | column 2 ", "---+----------+----------+----------",
      " 0 |   0-0    |   0-1    |   0-2    ", " 1 |          |   E      |          ",
      "   |          |   nde    |          ", "   |          |   avou   |          ",
      "   |   1-0    |   ros    |   1-2    ", " 2 |          |          | https:// ",
      "   |          |          | www      ", "   |          |          | .        ",
      "   |          |          | redhat   ", "   |          |   Red    | .com     ",
      "   |   2-0    |   Hat    | /en      ",
    ].join("\n"),
  )
}

///|
// Upstream: tabled/tests/settings/alignment_test.rs::alignment_doesnt_change_padding
test "upstream alignment alignment_doesnt_change_padding" {
  let actual = upstream_matrix(3, 3)
    .apply(@tabular.Style::psql())
    .with_(
      @tabular.Modify::new(@tabular.Segment::all()).with_(
        @tabular.Padding::new(3, 0, 0, 0),
      ),
    )
    .with_(
      @tabular.Modify::new(@tabular.Segment::all()).with_(
        @tabular.Alignment::left(),
      ),
    )
    .to_string()
  assert_eq(
    actual,
    [
      "   N|   column 0|   column 1|   column 2", "----+-----------+-----------+-----------",
      "   0|   0-0     |   0-1     |   0-2     ", "   1|   1-0     |   1-1     |   1-2     ",
      "   2|   2-0     |   2-1     |   2-2     ",
    ].join("\n"),
  )
}

