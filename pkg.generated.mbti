pub fn Table::split(Self, Split) -> Self
pub fn Table::to_string(Self) -> String
pub fn Table::total_height(Self) -> Int
pub fn Table::total_width(Self) -> Int
pub fn[T : TableOption] Table::with_(Self, T) -> Self

pub struct TableHeightIncrease[M, P] {
  height : M
  priority : P
} derive(@debug.Debug)
pub fn[M] TableHeightIncrease::new(M) -> Self[M, PriorityRoundRobin]
pub fn[M, P, Q] TableHeightIncrease::priority(Self[M, P], Q) -> Self[M, Q]
pub impl[M : Measurement, P : ResizeSelector] TableOption for TableHeightIncrease[M, P]

pub struct TableHeightLimit[M, P] {
  height : M
  priority : P
} derive(@debug.Debug)
pub fn[M] TableHeightLimit::new(M) -> Self[M, PriorityRoundRobin]
pub fn[M, P, Q] TableHeightLimit::priority(Self[M, P], Q) -> Self[M, Q]
pub impl[M : Measurement, P : ResizeSelector] TableOption for TableHeightLimit[M, P]

pub struct TextCleanup {
  // private fields
}
