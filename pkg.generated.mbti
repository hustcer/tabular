pub impl TableOption for TrimStrategy

pub struct Truncate[M, P] {
  width : M
  suffix : String
  suffix_limit : SuffixLimit
  multiline : Bool
  inherit_suffix_style : Bool
  priority : P
}
pub fn[M, P] Truncate::inherit_suffix_style(Self[M, P], Bool) -> Self[M, P]
pub fn[M, P] Truncate::multiline(Self[M, P], Bool) -> Self[M, P]
pub fn[M] Truncate::new(M) -> Self[M, PriorityRoundRobin]
pub fn[M, P, Q] Truncate::priority(Self[M, P], Q) -> Self[M, Q]
pub fn[M, P] Truncate::suffix(Self[M, P], String) -> Self[M, P]
pub fn[M, P] Truncate::suffix_limit(Self[M, P], SuffixLimit) -> Self[M, P]
pub fn Truncate::truncate(String, Int) -> String
pub impl[M : Measurement, P] CellOption for Truncate[M, P]
pub impl[M : Measurement, P : ResizeSelector] TableOption for Truncate[M, P]
pub impl[P] WidthOption for Truncate[Int, P]

pub struct UniformWidth[M] {
  width : M
}
pub fn UniformWidth::max() -> Self[Max]
pub fn UniformWidth::min() -> Self[Min]
pub fn[M] UniformWidth::new(M) -> Self[M]
pub impl[M : Measurement] TableOption for UniformWidth[M]

pub enum VAlign {
  Top
  Bottom
  Center
}
pub fn VAlign::bottom() -> Self
pub fn VAlign::center() -> Self
pub fn VAlign::top() -> Self
pub impl CellOption for VAlign
pub impl TableOption for VAlign

pub enum Width {
}
pub fn[M] Width::increase(M) -> MinWidth[M, PriorityRoundRobin]
pub fn Width::list(Array[Int]) -> WidthList
pub fn[M] Width::truncate(M, suffix? : String) -> Truncate[M, PriorityRoundRobin]
pub fn[M] Width::uniform(M) -> UniformWidth[M]
pub fn[M] Width::wrap(M) -> Wrap[M, PriorityRoundRobin]
pub fn Width::wrap_with(Int, String) -> Wrap[Int, PriorityRoundRobin]

pub struct WidthList {
  widths : Array[Int]
}
pub fn WidthList::from_array(Array[Int]) -> Self
pub fn WidthList::from_iter(Iter[Int]) -> Self
pub fn WidthList::new(Array[Int]) -> Self
