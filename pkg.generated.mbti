pub impl[M : Measurement, P] CellOption for Wrap[M, P]
pub impl[M : Measurement, P : ResizeSelector] TableOption for Wrap[M, P]
pub impl[P] WidthOption for Wrap[Int, P]

// Type aliases
pub using @papergrid {type Entity}

pub using @papergrid {type Indent}

pub using @papergrid {type Offset}

pub using @papergrid {type Sides}

// Traits
pub(open) trait CellOption {
  fn change(Self, Table, @papergrid.Entity) -> Unit
  fn hint_change(Self) -> @papergrid.Entity? = _
}
pub impl CellOption for String
pub impl[T : CellOption] CellOption for Array[T]
pub impl[T0 : CellOption, T1 : CellOption] CellOption for (T0, T1)
pub impl[T0 : CellOption, T1 : CellOption, T2 : CellOption] CellOption for (T0, T1, T2)
pub impl[T0 : CellOption, T1 : CellOption, T2 : CellOption, T3 : CellOption] CellOption for (T0, T1, T2, T3)
pub impl[T0 : CellOption, T1 : CellOption, T2 : CellOption, T3 : CellOption, T4 : CellOption] CellOption for (T0, T1, T2, T3, T4)
pub impl[T0 : CellOption, T1 : CellOption, T2 : CellOption, T3 : CellOption, T4 : CellOption, T5 : CellOption] CellOption for (T0, T1, T2, T3, T4, T5)
pub impl[T0 : CellOption, T1 : CellOption, T2 : CellOption, T3 : CellOption, T4 : CellOption, T5 : CellOption, T6 : CellOption] CellOption for (T0, T1, T2, T3, T4, T5, T6)
pub impl[T0 : CellOption, T1 : CellOption, T2 : CellOption, T3 : CellOption, T4 : CellOption, T5 : CellOption, T6 : CellOption, T7 : CellOption] CellOption for (T0, T1, T2, T3, T4, T5, T6, T7)
pub impl[T0 : CellOption, T1 : CellOption, T2 : CellOption, T3 : CellOption, T4 : CellOption, T5 : CellOption, T6 : CellOption, T7 : CellOption, T8 : CellOption] CellOption for (T0, T1, T2, T3, T4, T5, T6, T7, T8)
pub impl[T0 : CellOption, T1 : CellOption, T2 : CellOption, T3 : CellOption, T4 : CellOption, T5 : CellOption, T6 : CellOption, T7 : CellOption, T8 : CellOption, T9 : CellOption] CellOption for (T0, T1, T2, T3, T4, T5, T6, T7, T8, T9)

pub(open) trait HeightOption {
  fn to_mode(Self) -> @papergrid.HeightMode
}
pub impl HeightOption for @papergrid.HeightMode

pub(open) trait Measurement {
  fn measure(Self, Table, Attribute) -> Int
}
pub impl Measurement for Int

pub(open) trait Object {
  fn cells(Self, Table) -> Array[Array[(Int, Int)]]
  fn entities(Self, Table) -> Array[@papergrid.Entity] = _
}
pub impl Object for (Int, Int)

pub(open) trait ResizeSelector {
  fn select(Self, Array[Int], Array[Int]) -> Int?
}

pub(open) trait TableOption {
  fn change(Self, Table) -> Unit
  fn hint_change(Self) -> @papergrid.Entity? = _
}
pub impl[T : TableOption] TableOption for Array[T]
pub impl[T0 : TableOption, T1 : TableOption] TableOption for (T0, T1)
pub impl[T0 : TableOption, T1 : TableOption, T2 : TableOption] TableOption for (T0, T1, T2)
pub impl[T0 : TableOption, T1 : TableOption, T2 : TableOption, T3 : TableOption] TableOption for (T0, T1, T2, T3)
pub impl[T0 : TableOption, T1 : TableOption, T2 : TableOption, T3 : TableOption, T4 : TableOption] TableOption for (T0, T1, T2, T3, T4)
pub impl[T0 : TableOption, T1 : TableOption, T2 : TableOption, T3 : TableOption, T4 : TableOption, T5 : TableOption] TableOption for (T0, T1, T2, T3, T4, T5)
pub impl[T0 : TableOption, T1 : TableOption, T2 : TableOption, T3 : TableOption, T4 : TableOption, T5 : TableOption, T6 : TableOption] TableOption for (T0, T1, T2, T3, T4, T5, T6)
pub impl[T0 : TableOption, T1 : TableOption, T2 : TableOption, T3 : TableOption, T4 : TableOption, T5 : TableOption, T6 : TableOption, T7 : TableOption] TableOption for (T0, T1, T2, T3, T4, T5, T6, T7)
pub impl[T0 : TableOption, T1 : TableOption, T2 : TableOption, T3 : TableOption, T4 : TableOption, T5 : TableOption, T6 : TableOption, T7 : TableOption, T8 : TableOption] TableOption for (T0, T1, T2, T3, T4, T5, T6, T7, T8)
pub impl[T0 : TableOption, T1 : TableOption, T2 : TableOption, T3 : TableOption, T4 : TableOption, T5 : TableOption, T6 : TableOption, T7 : TableOption, T8 : TableOption, T9 : TableOption] TableOption for (T0, T1, T2, T3, T4, T5, T6, T7, T8, T9)

pub(open) trait WidthOption {
  fn to_mode(Self) -> @papergrid.WidthMode
}
pub impl WidthOption for @papergrid.WidthMode
