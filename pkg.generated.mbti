pub fn[H : HeightOption] Table::set_height(Self, H) -> Self
pub fn Table::set_padding(Self, Padding) -> Self
pub fn Table::set_valign(Self, VAlign) -> Self
pub fn[W : WidthOption] Table::set_width(Self, W) -> Self
pub fn Table::shadow(Self, Shadow) -> Self
