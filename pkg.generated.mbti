pub fn TextCleanup::new() -> Self
pub fn TextCleanup::remove_control_chars(Self) -> Self
pub impl CellOption for TextCleanup
pub impl TableOption for TextCleanup

pub(all) enum TieBreak {
  First
  Last
} derive(Eq, @debug.Debug)

