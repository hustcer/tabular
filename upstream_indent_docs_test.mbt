///|
// Upstream documentation: tabled/src/settings/padding/mod.rs
test "upstream indent documentation padding" {
  let table = @tabular.Table::from_rows([["char"], ["2"], ["0"], ["2"], ["2"]])
    .with_(@tabular.Style::modern())
    .modify((2, 0), @tabular.Padding::new(1, 1, 2, 2))
  assert_eq(
    table.to_string(),
    "┌──────┐\n│ char │\n├──────┤\n│ 2    │\n├──────┤\n│      │\n│      │\n│ 0    │\n│      │\n│      │\n├──────┤\n│ 2    │\n├──────┤\n│ 2    │\n└──────┘",
  )
}

