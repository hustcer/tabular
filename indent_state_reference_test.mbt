///|
// Reference: upstream padding expansion, colors, scopes, and margin offsets.
test "indent state reference row-over-column" {
  let table = @tabular.Table::from_rows([
    ["a\nb", "long value"],
    ["d", "x\ny\nz"],
    ["", "q"],
  ])
  table
  .modify(
    @tabular.Cols::first(),
    @tabular.Padding::new(2, 1, 2, 1).fill(
      left='>',
      right='<',
      top='^',
      bottom='v',
    ),
  )
  .modify(
    @tabular.Rows::first(),
    @tabular.Padding::new(1, 2, 1, 2).fill(
      left='a',
      right='b',
      top='c',
      bottom='d',
    ),
  )
  |> ignore
  assert_eq(
    table.to_string(),
    "+----+-------------+\n|cccc|ccccccccccccc|\n|aabb|along valuebb|\n|abbb|ddddddddddddd|\n|dddd|ddddddddddddd|\n|dddd|ddddddddddddd|\n+----+-------------+\n|^^^^| x           |\n|^^^^| y           |\n|>>d<| z           |\n|vvvv|             |\n+----+-------------+\n|^^^^| q           |\n|^^^^|             |\n|>> <|             |\n|vvvv|             |\n+----+-------------+",
  )
  assert_eq(table.dimension_snapshot().get_widths(), None)
  assert_eq(table.dimension_snapshot().get_heights(), None)
  assert_eq(table.total_width(), 20)
  assert_eq(table.total_height(), 17)
  assert_eq(table.rows, [["a\nb", "long value"], ["d", "x\ny\nz"], ["", "q"]])
  let padding = Array::makei(6, index => {
    let pad = table.config.get_padding(index / 2, index % 2)
    [pad.left.size, pad.right.size, pad.top.size, pad.bottom.size]
  })
  assert_eq(padding, [
    [1, 2, 1, 2],
    [1, 2, 1, 2],
    [2, 1, 2, 1],
    [1, 1, 0, 0],
    [2, 1, 2, 1],
    [1, 1, 0, 0],
  ])
}

