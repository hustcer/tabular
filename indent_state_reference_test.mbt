// Generated by scripts/import-indent-state-tests.nu.

///|
// Reference: upstream padding expansion, colors, scopes, and margin offsets.
test "indent state reference horizontal" {
  let table = @tabular.Table::from_rows([
    ["a\nb", "long value"],
    ["d", "x\ny\nz"],
    ["", "q"],
  ])
  table.with_(@tabular.PaddingExpand::Horizontal) |> ignore
  assert_eq(
    table.to_string(),
    "+---+------------+\n|a  |long value  |\n|b  |            |\n+---+------------+\n|d  |x           |\n|   |y           |\n|   |z           |\n+---+------------+\n|   |q           |\n+---+------------+",
  )
  assert_eq(table.dimension_snapshot().get_widths(), None)
  assert_eq(table.dimension_snapshot().get_heights(), None)
  assert_eq(table.total_width(), 18)
  assert_eq(table.total_height(), 10)
  assert_eq(table.rows, [["a\nb", "long value"], ["d", "x\ny\nz"], ["", "q"]])
  let padding = Array::makei(6, index => {
    let pad = table.config.get_padding(index / 2, index % 2)
    [pad.left.size, pad.right.size, pad.top.size, pad.bottom.size]
  })
  assert_eq(padding, [
    [0, 2, 0, 0],
    [0, 2, 0, 0],
    [0, 2, 0, 0],
    [0, 11, 0, 0],
    [0, 3, 0, 0],
    [0, 11, 0, 0],
  ])
}

