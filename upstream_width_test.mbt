test "upstream width max_width_wrapped_collored" {
  let actual = {
    let data = [
      @tabular.Color::fg_red().colorize("asd"),
      @tabular.Color::fg_blue().colorize("zxc2"),
      (@tabular.Color::fg_green() | @tabular.Color::bg_black()).colorize(
        "asdasd",
      ),
    ]

    upstream_width_strings(data, "String")
    .set_align(@tabular.Align::center())
    .apply(@tabular.Style::markdown())
    .modify(@tabular.Segment::all(), @tabular.Width::wrap(2))
    .to_string()
  }
  assert_eq(
    actual, "| St |\n| ri |\n| ng |\n|----|\n| \u001b[31mas\u001b[39m |\n| \u001b[31md\u001b[39m  |\n| \u001b[34mzx\u001b[39m |\n| \u001b[34mc2\u001b[39m |\n| \u001b[32m\u001b[40mas\u001b[39m\u001b[49m |\n| \u001b[32m\u001b[40mda\u001b[39m\u001b[49m |\n| \u001b[32m\u001b[40msd\u001b[39m\u001b[49m |",
  )
}

///|
// Upstream: tabled/tests/settings/width_test.rs::dont_change_content_if_width_is_less_then_max_width
test "upstream width dont_change_content_if_width_is_less_then_max_width" {
  let actual = upstream_matrix(3, 3)
    .apply(@tabular.Style::markdown())
    .with_(
      @tabular.Modify::new(@tabular.Segment::all()).with_(
        @tabular.Width::truncate(1000).suffix("..."),
      ),
    )
    .to_string()
  assert_eq(
    actual,
    (
      #|| N | column 0 | column 1 | column 2 |
      #||---|----------|----------|----------|
      #|| 0 |   0-0    |   0-1    |   0-2    |
      #|| 1 |   1-0    |   1-1    |   1-2    |
      #|| 2 |   2-0    |   2-1    |   2-2    |
    ),
  )
}

///|
// Upstream: tabled/tests/settings/width_test.rs::max_width_with_emoji
test "upstream width max_width_with_emoji" {
  let actual = upstream_width_strings(
      [
        "🤠", "😳🥵🥶😱😨", "🚴🏻‍♀️🚴🏻🚴🏻‍♂️🚵🏻‍♀️🚵🏻🚵🏻‍♂️",
      ],
      "&str",
    )
    .set_align(@tabular.Align::center())
    .apply(@tabular.Style::markdown())
    .modify(@tabular.Segment::all(), @tabular.Width::truncate(6).suffix("..."))
    .to_string()
  assert_eq(
    actual,
    (
      #||  &str  |
      #||--------|
      #||   🤠   |
      #|| 😳�... |
      #|| 🚴�... |
    ),
  )
}

///|
// Upstream: tabled/tests/settings/width_test.rs::color_chars_are_stripped
test "upstream width color_chars_are_stripped" {
  let actual = upstream_width_strings(
      [
        @tabular.Color::fg_red().colorize("asd"),
        @tabular.Color::fg_blue().colorize("zxc"),
