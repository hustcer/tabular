    .set_align(@tabular.Align::center())
    .apply(@tabular.Style::markdown())
    .modify(@tabular.Segment::all(), @tabular.Width::truncate(4).suffix("..."))
    .to_string()
  assert_eq(
    actual, "| S... |\n|------|\n| \u001b[31masd\u001b[39m  |\n| \u001b[34mzxc\u001b[39m  |\n| \u001b[32m\u001b[40ma\u001b[39m\u001b[49m... |",
  )
}

