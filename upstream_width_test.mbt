    .apply(@tabular.Style::markdown())
    .with_(@tabular.Width::wrap(0).priority(@tabular.PriorityMin::right()))
    .to_string()
  assert_eq(
    actual,
    (
      #||  |  |  |  |
      #||--|--|--|--|
      #||  |  |  |  |
      #||  |  |  |  |
      #||  |  |  |  |
    ),
  )
}

