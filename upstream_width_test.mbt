///|
// Upstream: tabled/tests/settings/width_test.rs::max_width_with_span_0
test "upstream width max_width_with_span_0" {
  let actual = upstream_matrix(3, 3)
    .modify_cell(
      @tabular.Cell::new(1, 1),
      @tabular.Setting::format(@tabular.Format::value("a long string")),
    )
    .apply(@tabular.Style::psql())
    .with_(@tabular.Modify::new((1, 1)).with_(@tabular.Span::column(2)))
    .with_(@tabular.Modify::new((2, 2)).with_(@tabular.Span::column(2)))
    .with_(@tabular.Width::truncate(40))
    .to_string()
  assert_eq(
    actual,
    [
      " N | column 0 | column 1 | column 2 ", "---+----------+----------+----------",
      " 0 |    a long string    |   0-2    ", " 1 |   1-0    |         1-1         ",
      " 2 |   2-0    |   2-1    |   2-2    ",
    ].join("\n"),
  )
}

///|
// Upstream: tabled/tests/settings/width_test.rs::max_width_with_span_1
test "upstream width max_width_with_span_1" {
