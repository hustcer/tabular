  let actual = upstream_width_strings([], "usize")
    .panel(@tabular.Panel::horizontal(0, "Hello World"))
    .with_(
      @tabular.Modify::new(@tabular.Segment::all())
      .with_(@tabular.Alignment::center())
      .with_(@tabular.Padding::zero()),
    )
    .with_(@tabular.Width::truncate(5))
    .with_(@tabular.MinWidth::new(5))
    .to_string()
  assert_eq(
    actual,
    (
      #|+---+
      #||Hel|
      #|+---+
      #||usi|
      #|+---+
    ),
  )
}

