    .with_(@tabular.Width::wrap(20).priority(@tabular.PriorityMax::right()))
    .to_string()
  assert_eq(
    actual,
    (
      #|| N | co | co | co |
      #||   | lu | lu | lu |
      #||   | mn | mn | mn |
      #||   |  0 |  1 |  2 |
      #||---|----|----|----|
      #|| 0 | 0- | 0- | 0- |
      #||   | 0  | 1  | 2  |
      #|| 1 | He | 1- | 1- |
      #||   | ll | 1  | 2  |
      #||   | o  |    |    |
      #||   | Wo |    |    |
      #||   | rl |    |    |
      #||   | d  |    |    |
      #||   | Wi |    |    |
      #||   | th |    |    |
      #||   |  B |    |    |
      #||   | ig |    |    |
      #||   |  L |    |    |
      #||   | in |    |    |
      #||   | e  |    |    |
      #|| 2 | 2- | 2- | 2- |
      #||   | 0  | 1  | 2  |
    ),
  )
}

