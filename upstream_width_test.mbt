      ["2", "3"],
    ])
    .set_align(@tabular.Align::center())
    .apply(@tabular.Style::markdown())
    .with_(@tabular.Modify::new((1, 0)).with_(@tabular.Span::column(2)))
    .with_(@tabular.MinWidth::new(100))
    .to_string()
  assert_eq(
    actual,
    (
      #||                                   0                                    |            1            |
      #||------------------------------------------------------------------------|-------------------------|
      #||                                                0                                                 |
      #||            a long string which will affect min width logic             |                         |
      #||                                   2                                    |            3            |
    ),
  )
}

