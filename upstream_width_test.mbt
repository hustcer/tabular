///|
// Upstream: tabled/tests/settings/width_test.rs::min_width_works_with_right_alignment_0
test "upstream width min_width_works_with_right_alignment_0" {
  let actual = ({
    let json = "\n        {\n            \"some\": \"random\",\n            \"json\": [\n                { \"1\": \"2\" },\n                { \"1\": \"2\" },\n                { \"1\": \"2\" }\n            ]\n        }\n        "

    upstream_width_strings([json], "&str")
    .set_align(@tabular.Align::center())
    .apply(@tabular.Style::markdown())
    .with_(@tabular.Alignment::right())
    .with_(@tabular.TrimStrategy::None)
    .with_(@tabular.MinWidth::new(50))
  }).to_string()
  assert_eq(
    actual,
    (
      #||                                           &str |
      #||------------------------------------------------|
      #||                                                |
      #||                          {                     |
      #||                              "some": "random", |
      #||                              "json": [         |
      #||                                  { "1": "2" }, |
      #||                                  { "1": "2" }, |
      #||                                  { "1": "2" }  |
      #||                              ]                 |
      #||                          }                     |
      #||                                                |
    ),
  )
}

