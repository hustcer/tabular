///|
// Upstream: tabled/tests/settings/width_test.rs::cell_truncate_multiline
test "upstream width cell_truncate_multiline" {
  let actual = upstream_matrix(3, 3)
    .modify_cell(
      @tabular.Cell::new(1, 1),
      @tabular.Setting::format(@tabular.Format::value("H\nel\nlo World")),
    )
    .modify_cell(
      @tabular.Cell::new(3, 2),
      @tabular.Setting::format(@tabular.Format::value("multi\nline string\n")),
    )
    .apply(@tabular.Style::markdown())
    .modify(
      @tabular.Cols::new(1, 2).not_rows(@tabular.Rows::one(0)),
      @tabular.Width::truncate(1).multiline(true),
    )
    .to_string()
  assert_eq(
    actual,
    (
      #|| N | column 0 |  column 1   | column 2 |
      #||---|----------|-------------|----------|
      #|| 0 |    H     |     0-1     |   0-2    |
      #||   |    e     |             |          |
      #||   |    l     |             |          |
      #|| 1 |    1     |     1-1     |   1-2    |
      #|| 2 |    2     | multi       |   2-2    |
      #||   |          | line string |          |
      #||   |          |             |          |
    ),
  )
}

