///|
// Upstream: tabled/tests/settings/width_test.rs::min_with_max_width_truncate_suffix_try_color
test "upstream width min_with_max_width_truncate_suffix_try_color" {
  let actual = ({
    let data = [
      @tabular.Color::fg_red().colorize("asd"),
      @tabular.Color::fg_blue().colorize("zxc2"),
      (@tabular.Color::fg_green() | @tabular.Color::bg_black()).colorize(
        "asdasd",
      ),
    ]

    upstream_width_strings(data, "String")
    .set_align(@tabular.Align::center())
    .apply(@tabular.Style::markdown())
    .with_(@tabular.Width::truncate(7).suffix("..").suffix_try_color(true))
  }).to_string()
  assert_eq(
    actual, "| S.. |\n|-----|\n| \u001b[31masd\u001b[39m |\n| \u001b[34mz\u001b[39m\u001b[34m..\u001b[39m |\n| \u001b[32m\u001b[40ma\u001b[39m\u001b[49m\u001b[32m\u001b[40m..\u001b[39m\u001b[49m |",
  )
}

