///|
// Upstream: tabled/tests/settings/width_test.rs::max_width_keep_words_3
test "upstream width max_width_keep_words_3" {
  let actual = {
    let m = upstream_width_arrays([
      ["123 45678", "qweqw eqwe", "..."],
      ["0", "1", "..."],
      ["0", "1", "..."],
    ]).set_align(@tabular.Align::center())

    m
    .with_(@tabular.Alignment::center())
    .with_(
      @tabular.Style::modern()
      .remove_horizontal()
      .horizontals([
        (1, @tabular.HorizontalLine::from_style(@tabular.Style::modern())),
      ]),
    )
    .with_(
      @tabular.Width::wrap(21)
      .keep_words(true)
      .priority(@tabular.PriorityMax::right()),
    )
    .to_string()
  }
  assert_eq(
    actual,
    (
      #|┌──────┬──────┬─────┐
      #|│  0   │  1   │  2  │
      #|├──────┼──────┼─────┤
      #|│ 123  │ qweq │ ... │
      #|│ 4567 │ w    │     │
      #|│ 8    │ eqwe │     │
      #|│  0   │  1   │ ... │
      #|│  0   │  1   │ ... │
      #|└──────┴──────┴─────┘
    ),
  )
}

