///|
// Upstream: tabled/tests/settings/width_test.rs::wrapping_as_total_multiline
test "upstream width wrapping_as_total_multiline" {
  let expected = [
    (
      #|| ver | published_d | is_act | major_feature            |
      #|| sio | ate         | ive    |                          |
      #|| n   |             |        |                          |
      #||-----|-------------|--------|--------------------------|
      #|| 0.2 | 2021-06-23  | true   | #[header(inline)] attrib |
      #|| .1  |             |        | ute                      |
      #|| 0.2 | 2021-06-19  | false  | API changes              |
      #|| .0  |             |        |                          |
      #|| 0.1 | 2021-06-07  | false  | display_with attribute   |
      #|| .4  |             |        |                          |
    ),
    (
      #|| ver | published_d | is_act | major_feature            |
      #|| sio | ate         | ive    |                          |
      #|| n   |             |        |                          |
      #||-----|-------------|--------|--------------------------|
      #|| 0.2 | 2021-06-23  | true   | #[header(inline)]        |
      #|| .1  |             |        | attribute                |
      #|| 0.2 | 2021-06-19  | false  | API changes              |
      #|| .0  |             |        |                          |
      #|| 0.1 | 2021-06-07  | false  | display_with attribute   |
      #|| .4  |             |        |                          |
    ),
  ]
  for index, words in [false, true] {
    let table = upstream_width_versions(false)
      .with_(@tabular.Alignment::left())
      .with_(@tabular.Width::wrap(57).keep_words(words))
      .to_string()
    assert_eq(table, expected[index])
    upstream_assert_width(table, 57)
  }
}

///|
// Upstream: tabled/tests/settings/width_test.rs::wrapping_as_total_multiline_color
test "upstream width wrapping_as_total_multiline_color" {
  let expected = [
    "| ver | published_d | is_act | major_feature            |\n| sio | ate         | ive    |                          |\n| n   |             |        |                          |\n|-----|-------------|--------|--------------------------|\n| \u001b[31m0.2\u001b[39m | \u001b[31m\u001b[48;2;8;10;30m2021-06-23\u001b[39m\u001b[49m  | true   | \u001b[34m\u001b[42m#[header(inline)] attrib\u001b[39m\u001b[49m |\n| \u001b[31m.1\u001b[39m  |             |        | \u001b[34m\u001b[42mute\u001b[39m\u001b[49m                      |\n| \u001b[31m0.2\u001b[39m | \u001b[32m\u001b[48;2;8;100;30m2021-06-19\u001b[39m\u001b[49m  | false  | \u001b[33mAPI changes\u001b[39m              |\n| \u001b[31m.0\u001b[39m  |             |        |                          |\n| \u001b[37m0.1\u001b[39m | \u001b[31m\u001b[48;2;8;10;30m2021-06-07\u001b[39m\u001b[49m  | false  | \u001b[31m\u001b[40mdisplay_with attribute\u001b[39m\u001b[49m   |\n| \u001b[37m.4\u001b[39m  |             |        |                          |",
    "| ver | published_d | is_act | major_feature            |\n| sio | ate         | ive    |                          |\n| n   |             |        |                          |\n|-----|-------------|--------|--------------------------|\n| \u001b[31m0.2\u001b[39m | \u001b[31m\u001b[48;2;8;10;30m2021-06-23\u001b[39m\u001b[49m  | true   | \u001b[34m\u001b[42m#[header(inline)] \u001b[39m\u001b[49m       |\n| \u001b[31m.1\u001b[39m  |             |        | \u001b[34m\u001b[42mattribute\u001b[39m\u001b[49m                |\n| \u001b[31m0.2\u001b[39m | \u001b[32m\u001b[48;2;8;100;30m2021-06-19\u001b[39m\u001b[49m  | false  | \u001b[33mAPI changes\u001b[39m              |\n| \u001b[31m.0\u001b[39m  |             |        |                          |\n| \u001b[37m0.1\u001b[39m | \u001b[31m\u001b[48;2;8;10;30m2021-06-07\u001b[39m\u001b[49m  | false  | \u001b[31m\u001b[40mdisplay_with attribute\u001b[39m\u001b[49m   |\n| \u001b[37m.4\u001b[39m  |             |        |                          |",
  ]
  for index, words in [false, true] {
    let table = upstream_width_versions(true)
      .with_(@tabular.Alignment::left())
      .with_(@tabular.Width::wrap(57).keep_words(words))
      .to_string()
    assert_eq(table, expected[index])
    upstream_assert_width(table, 57)
  }
}

///|
// Upstream: tabled/tests/settings/width_test.rs::truncating_as_total_multiline_color
test "upstream width truncating_as_total_multiline_color" {
  let expected = [
    (
      #|| ver | published_d | is_act | major_feature            |
      #||-----|-------------|--------|--------------------------|
      #|| 0.2 | 2021-06-23  | true   | #[header(inline)] attrib |
      #|| 0.2 | 2021-06-19  | false  | API changes              |
      #|| 0.1 | 2021-06-07  | false  | display_with attribute   |
    ),
    "| ver | published_d | is_act | major_feature            |\n|-----|-------------|--------|--------------------------|\n| \u001b[31m0.2\u001b[39m | \u001b[31m\u001b[48;2;8;10;30m2021-06-23\u001b[39m\u001b[49m  | true   | \u001b[34m\u001b[42m#[header(inline)] attrib\u001b[39m\u001b[49m |\n| \u001b[31m0.2\u001b[39m | \u001b[32m\u001b[48;2;8;100;30m2021-06-19\u001b[39m\u001b[49m  | false  | \u001b[33mAPI changes\u001b[39m              |\n| \u001b[37m0.1\u001b[39m | \u001b[31m\u001b[48;2;8;10;30m2021-06-07\u001b[39m\u001b[49m  | false  | \u001b[31m\u001b[40mdisplay_with attribute\u001b[39m\u001b[49m   |",
  ]
  let table = upstream_width_versions(true)
    .with_(@tabular.Alignment::left())
    .with_(@tabular.Width::truncate(57))
    .to_string()
  assert_eq(@papergrid.strip_ansi(table), expected[0])
  assert_eq(table, expected[1])
  assert_eq(@papergrid.get_text_width(table), 57)
}

///|
// Upstream: tabled/tests/settings/width_test.rs::hyperlinks
test "upstream width hyperlinks" {
  let expected = [
    "+-------+-------+\n| name  | is_hy |\n|       | perli |\n|       | nk    |\n+-------+-------+\n| \u001b]8;;https://www.debian.org/\u001b\\Debia\u001b]8;;\u001b\\ | true  |\n| \u001b]8;;https://www.debian.org/\u001b\\n\u001b]8;;\u001b\\     |       |\n+-------+-------+",
    (
      #|+-------+-------+
      #|| name  | is_hy |
      #||       | perli |
      #||       | nk    |
      #|+-------+-------+
      #|| Debia | true  |
      #|| n     |       |
      #|| :link |       |
      #|+-------+-------+
    ),
    (
      #|+-------+-------+
      #|| name  | is_hy |
      #||       | perli |
      #||       | nk    |
      #|+-------+-------+
      #|| asd D | true  |
      #|| ebian |       |
      #||  2    |       |
      #|| links |       |
      #||  in a |       |
      #||  stri |       |
      #|| ng De |       |
      #|| bian  |       |
      #|+-------+-------+
    ),
  ]
  for index, text in upstream_width_links(false, false) {
    let table = @tabular.Table::from_rows([
        ["name", "is_hyperlink"],
        [text, "true"],
      ])
      .with_(
        @tabular.Modify::new(@tabular.Segment::all())
        .with_(@tabular.Width::wrap(5).keep_words(true))
        .with_(@tabular.Alignment::left()),
      )
      .to_string()
    assert_eq(table, expected[index])
  }
}

///|
// Upstream: tabled/tests/settings/width_test.rs::hyperlinks_with_color
test "upstream width hyperlinks_with_color" {
  let expected = [
    "+--------+--------+\n| name   | is_hyp |\n|        | erlink |\n+--------+--------+\n| \u001b]8;;https://www.debian.org/\u001b\\\u001b[31mDebian\u001b[39m\u001b]8;;\u001b\\ | true   |\n+--------+--------+",
    (
      #|+--------+--------+
      #|| name   | is_hyp |
      #||        | erlink |
      #|+--------+--------+
      #|| Debian | true   |
      #||  :link |        |
      #|+--------+--------+
    ),
    (
      #|+--------+--------+
      #|| name   | is_hyp |
      #||        | erlink |
      #|+--------+--------+
      #|| asd    | true   |
      #|| Debian |        |
      #||  2     |        |
      #|| links  |        |
      #|| in a   |        |
      #|| string |        |
      #||        |        |
      #|| Debian |        |
      #|+--------+--------+
    ),
  ]
  for index, text in upstream_width_links(true, false) {
    let table = @tabular.Table::from_rows([
        ["name", "is_hyperlink"],
        [text, "true"],
      ])
      .with_(
        @tabular.Modify::new(@tabular.Segment::all())
        .with_(@tabular.Width::wrap(6).keep_words(true))
        .with_(@tabular.Alignment::left()),
      )
      .to_string()
    assert_eq(table, expected[index])
  }
}

